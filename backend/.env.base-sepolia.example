# Backend configuration for Base Sepolia testnet (chainId 84532).
# Copy this file to backend/.env and fill in the keys.

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379

# Auth (required)
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string

# ── 0G Chain (agent infra) ──────────────────────────────────────────────────
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602

# ── Base Chain (settlement) ─────────────────────────────────────────────────
BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
BASE_CHAIN_ID=84532
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Contract addresses (escrow, factory, AA) come from the generated records
# for these chain ids (contracts/deployments/*-sepolia.json, via
# contracts/scripts/sync-addresses.ts). No address vars.
# Deployment block of that escrow. Set it on a stack whose database already
# holds Base tasks but whose Redis is new (a staging stack, or production on a
# new Redis): indexing then starts here instead of at the head. The catch-up
# takes hours, so leave it off for local development, where /tasks/index
# seeds every task you post anyway.
# BASE_ESCROW_DEPLOYMENT_BLOCK=46211199

# ── ERC-4337 Account Abstraction (Base Sepolia) ─────────────────────────────
# Addresses from contracts/deployments/aa-base-sepolia.json (generated). No vars.

# Pimlico bundler for UserOp submission
PIMLICO_BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc
PIMLICO_API_KEY=

# ── Signers ─────────────────────────────────────────────────────────────────
# Must hold Base Sepolia ETH to deploy smart accounts and relay verifier txs
BASE_MARKETPLACE_SIGNER_PRIVATE_KEY=
# 0G verifier + storage signers
MARKETPLACE_SIGNER_PRIVATE_KEY=
OG_STORAGE_PRIVATE_KEY=

# 0G Compute (optional)
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false
