# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://www.blindmarket.xyz

# Node runtime: prefer IPv4 DNS first on hosts without working IPv6 egress
# (DNS returns v6 addresses first; dead v6 kills outbound calls with empty
# "Cannot connect" errors). Omit on healthy hosts.
# NODE_OPTIONS=--dns-result-order=ipv4first

# Redis
REDIS_URL=redis://localhost:6379

# Which stack this is, for the Redis ownership check
# (services/deploymentIdentity.ts): "production" on production. A staging
# stack or a local backend on another deployment's Redis stops its
# background writes; production never does (it takes its Redis back).
# DEPLOYMENT_CLAIM, for ONE boot, lets a staging stack take a Redis over on
# purpose: set it to the owner it replaces (/health/bridge
# deploymentIdentity.owner) or "unclaimed".
# DEPLOYMENT_ID=production
# DEPLOYMENT_CLAIM=

# Auth
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string
FOUNDER_ADDRESSES=
# Gates CLI/SDK device-flow registration (POST /registration/session,
# /registration/confirm/:token). Defaults to false. Does not affect the web
# agent-deploy flow (POST /agents/deploy).
REGISTRATION_ENABLED=false
# Unix timestamp (seconds). Registration-minted JWTs issued before this time
# are rejected. Setting it to "now" invalidates every previously issued
# registration token and forces re-registration. Leave unset/0 to disable.
REGISTRATION_TOKEN_MIN_IAT=

# CORS
CORS_ORIGIN=http://localhost:5173

# ── 0G Chain (agent infra) ──────────────────────────────────────────────────
OG_RPC_URL=https://evmrpc.0g.ai
OG_CHAIN_ID=16661
BLIND_ESCROW_ADDRESS=
TASK_REGISTRY_ADDRESS=
BLIND_REPUTATION_ADDRESS=
INFT_ADDRESS=
# ValidatorPool (no generated default; empty or zero = not deployed)
VALIDATOR_POOL_ADDRESS=
# Where the 0G indexer's recovery backfill starts. The default, 33459885, is at
# or before the first task on both the 0G mainnet and 0G testnet escrows.
# ESCROW_DEPLOYMENT_BLOCK=33459885

# ── Base Chain (settlement — USDC payouts) ──────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
BASE_ESCROW_ADDRESS=
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Block the Base escrow was deployed in. Used only when Redis has no Base
# checkpoint (first boot, new Redis): indexing starts there instead of at the
# head, catching up 500 blocks every 5 s. Leave unset to start at the head.
# BASE_ESCROW_DEPLOYMENT_BLOCK=

# ── ERC-4337 Account Abstraction (Base) ─────────────────────────────────────
# Smart accounts let workers pay gas in USDC via the paymaster instead of ETH.
# Addresses are written by contracts/scripts/sync-addresses.ts; set them here
# if you are not using the generated contractAddresses.ts file.
BLIND_ACCOUNT_FACTORY_ADDRESS=
USDC_PAYMASTER_ADDRESS=
ENTRY_POINT_ADDRESS=

# Pimlico bundler for UserOp submission on Base (or any v0.7 ERC-4337 bundler)
PIMLICO_BUNDLER_URL=
PIMLICO_API_KEY=

# ── Circle CCTP V2 (Base <-> another EVM chain USDC bridging) ───────────────
# Default OFF — routes 400 CCTP_DISABLED and the attestation poller no-ops
# until set. Network tier follows BASE_CHAIN_ID, not NODE_ENV: 84532 (Base
# Sepolia) → testnet chains + Arc Testnet, testnet contracts, Iris sandbox;
# only 8453 (Base mainnet) → mainnet. So a NODE_ENV=production deploy on Base
# Sepolia bridges on testnets. Live-verified on testnet (Sep 2026): Eth
# Sepolia→Base Sepolia and Base Sepolia→Arc, Forwarding Service mints.
CCTP_ENABLED=false
# TokenMessengerV2 / MessageTransmitterV2 — same address on every EVM chain
# for a given network tier (Circle's deterministic deployment); defaults
# below are correct for both mainnet and testnet, only override if Circle
# redeploys.
CCTP_TOKEN_MESSENGER_ADDRESS=
CCTP_MESSAGE_TRANSMITTER_ADDRESS=
# Iris attestation API base URL — defaults to the sandbox on a Base Sepolia
# deployment, the live API on Base mainnet (tier follows BASE_CHAIN_ID).
CCTP_IRIS_API_BASE=
# Ethereum, Arbitrum, and Optimism — the non-Base CCTP chains wired up today
# (all Fast-Transfer-eligible, so they share the same code path as Base with
# no extra infrastructure). Polygon PoS and Avalanche are deliberately NOT
# included — Circle doesn't support Fast Transfer/Forwarding Service on
# either, which would need a real automated relayer, not just a config
# entry. Default RPCs below are public, rate-limited endpoints (fine for
# testnet) — set real providers (Alchemy/Infura/etc.) before production traffic.
CCTP_ETHEREUM_RPC_URL=
CCTP_ETHEREUM_CHAIN_ID=
CCTP_ETHEREUM_USDC_ADDRESS=
CCTP_ARBITRUM_RPC_URL=
CCTP_ARBITRUM_CHAIN_ID=
CCTP_ARBITRUM_USDC_ADDRESS=
CCTP_OPTIMISM_RPC_URL=
CCTP_OPTIMISM_CHAIN_ID=
CCTP_OPTIMISM_USDC_ADDRESS=
# Arc Testnet (Circle's L1) — these settings cover Arc testnet only; Arc
# mainnet is not wired up here. USDC is Arc's gas token, so a deposit FROM
# Arc must leave CCTP_ARC_GAS_RESERVE_RAW (6-dec USDC; default 50000 =
# 0.05 USDC) behind to pay the approve + burn gas.
CCTP_ARC_RPC_URL=
CCTP_ARC_CHAIN_ID=
CCTP_ARC_USDC_ADDRESS=
CCTP_ARC_GAS_RESERVE_RAW=
# Only needed to run scripts/recover-stuck-cctp-transfer.ts — a wallet with
# native gas on whichever destination chain a stalled transfer is minting
# into (on Arc, native gas is USDC, not ETH). Not used by the running server.
CCTP_RECOVERY_PRIVATE_KEY=

# ── Signers ─────────────────────────────────────────────────────────────────
# 0G marketplace signer (verifier role on 0G BlindEscrow — assignment)
MARKETPLACE_SIGNER_PRIVATE_KEY=
# Base marketplace signer (verifier role on Base BlindEscrow — USDC payout)
BASE_MARKETPLACE_SIGNER_PRIVATE_KEY=
# contracts/ deployment set this stack's contracts are recorded in: unset (or
# "default") for production, "staging" for the staging stack. With a set,
# printed rotate-verifier commands select it, and boot fails unless
# OG_CHAIN_ID=16602, BASE_CHAIN_ID=84532, OG_RPC_URL and every contract address
# (including VALIDATOR_POOL_ADDRESS) are set explicitly. See contracts/README.md.
# DEPLOYMENT_SET=
# 0G storage signer (INFT mint, etc.)
OG_STORAGE_PRIVATE_KEY=

# Verification (0G Compute Sealed Inference)
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false

# Railway Sandboxes
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
SANDBOX_IDLE_TIMEOUT_MINUTES=5
SANDBOX_MAX_CONCURRENT=3
SANDBOX_COST_PER_SECOND=1000

# Per-principal rate limits on the two routes that spend real money per call
# (plan 014). /sandbox/exec runs an arbitrary shell command for up to 600s
# billed to the platform; /verification/verify spends a paid 0G Compute
# inference per call.
SANDBOX_RATE_PER_MIN=10
VERIFY_RATE_PER_MIN=20
# Rolling daily cost ceiling per principal for /sandbox/exec, in micro-units
# (same unit as SANDBOX_COST_PER_SECOND). Enforced via Redis so it survives
# restarts and is shared across instances. Runaway brake, not a billing plan —
# fails OPEN (allows the call) if Redis is unreachable.
SANDBOX_DAILY_COST_CAP_MICRO=10000000

# Sentry DSN for backend error monitoring (5xx + crashes only). Unset = disabled.
SENTRY_DSN=
# Sentry environment tag. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
