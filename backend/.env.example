# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://www.blindmarket.xyz

# Redis
REDIS_URL=redis://localhost:6379

# Auth
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string
FOUNDER_ADDRESSES=
# Gates CLI/SDK device-flow registration (POST /registration/session,
# /registration/confirm/:token). Defaults to false. Does not affect the web
# agent-deploy flow (POST /agents/deploy).
REGISTRATION_ENABLED=false
# Unix timestamp (seconds). Registration-minted JWTs issued before this time
# are rejected. Setting it to "now" invalidates every previously issued
# registration token and forces re-registration. Leave unset/0 to disable.
REGISTRATION_TOKEN_MIN_IAT=

# CORS
CORS_ORIGIN=http://localhost:5173

# ── 0G Chain (agent infra) ──────────────────────────────────────────────────
OG_RPC_URL=https://evmrpc.0g.ai
OG_CHAIN_ID=16661
BLIND_ESCROW_ADDRESS=
TASK_REGISTRY_ADDRESS=
BLIND_REPUTATION_ADDRESS=
INFT_ADDRESS=

# ── Base Chain (settlement — USDC payouts) ──────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
BASE_ESCROW_ADDRESS=
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Circle CCTP V2 (Base <-> another EVM chain USDC bridging) ───────────────
# Default OFF — routes 400 CCTP_DISABLED and the attestation poller no-ops
# until set. See docs/... (or ask about the feat/cctp-base-bridging branch)
# before enabling in production — the Forwarding Service fee-attachment
# mechanism was not verified against a live testnet round-trip as of this
# writing.
CCTP_ENABLED=false
# TokenMessengerV2 / MessageTransmitterV2 — same address on every EVM chain
# for a given network tier (Circle's deterministic deployment); defaults
# below are correct for both mainnet and testnet, only override if Circle
# redeploys.
CCTP_TOKEN_MESSENGER_ADDRESS=
CCTP_MESSAGE_TRANSMITTER_ADDRESS=
# Iris attestation API base URL — defaults to the sandbox in dev, live in prod.
CCTP_IRIS_API_BASE=
# Ethereum leg — the only non-Base CCTP chain wired up today. The default RPC
# is a public, rate-limited endpoint (fine for testnet verification) — set a
# real provider (Alchemy/Infura/etc.) before any production traffic.
CCTP_ETHEREUM_RPC_URL=
CCTP_ETHEREUM_CHAIN_ID=
CCTP_ETHEREUM_USDC_ADDRESS=
# Only needed to run scripts/recover-stuck-cctp-transfer.ts — a wallet with
# native gas on whichever destination chain a stalled transfer is minting
# into. Not used by the running server.
CCTP_RECOVERY_PRIVATE_KEY=

# ── Signers ─────────────────────────────────────────────────────────────────
# 0G marketplace signer (verifier role on 0G BlindEscrow — assignment)
MARKETPLACE_SIGNER_PRIVATE_KEY=
# Base marketplace signer (verifier role on Base BlindEscrow — USDC payout)
BASE_MARKETPLACE_SIGNER_PRIVATE_KEY=
# 0G storage signer (INFT mint, etc.)
OG_STORAGE_PRIVATE_KEY=

# Verification (0G Compute Sealed Inference)
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false

# Railway Sandboxes
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
SANDBOX_IDLE_TIMEOUT_MINUTES=5
SANDBOX_MAX_CONCURRENT=3
SANDBOX_COST_PER_SECOND=1000

# Per-principal rate limits on the two routes that spend real money per call
# (plan 014). /sandbox/exec runs an arbitrary shell command for up to 600s
# billed to the platform; /verification/verify spends a paid 0G Compute
# inference per call.
SANDBOX_RATE_PER_MIN=10
VERIFY_RATE_PER_MIN=20
# Rolling daily cost ceiling per principal for /sandbox/exec, in micro-units
# (same unit as SANDBOX_COST_PER_SECOND). Enforced via Redis so it survives
# restarts and is shared across instances. Runaway brake, not a billing plan —
# fails OPEN (allows the call) if Redis is unreachable.
SANDBOX_DAILY_COST_CAP_MICRO=10000000
