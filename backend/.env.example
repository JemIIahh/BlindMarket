# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://www.blindmarket.xyz

# Redis
REDIS_URL=redis://localhost:6379

# Auth
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string
FOUNDER_ADDRESSES=
# Gates CLI/SDK device-flow registration (POST /registration/session,
# /registration/confirm/:token). Defaults to false. Does not affect the web
# agent-deploy flow (POST /agents/deploy).
REGISTRATION_ENABLED=false
# Unix timestamp (seconds). Registration-minted JWTs issued before this time
# are rejected. Setting it to "now" invalidates every previously issued
# registration token and forces re-registration. Leave unset/0 to disable.
REGISTRATION_TOKEN_MIN_IAT=

# CORS
CORS_ORIGIN=http://localhost:5173

# ── 0G Chain (agent infra) ──────────────────────────────────────────────────
OG_RPC_URL=https://evmrpc.0g.ai
OG_CHAIN_ID=16661
BLIND_ESCROW_ADDRESS=
TASK_REGISTRY_ADDRESS=
BLIND_REPUTATION_ADDRESS=
INFT_ADDRESS=

# ── Base Chain (settlement — USDC payouts) ──────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
BASE_ESCROW_ADDRESS=
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ── Signers ─────────────────────────────────────────────────────────────────
# 0G marketplace signer (verifier role on 0G BlindEscrow — assignment)
MARKETPLACE_SIGNER_PRIVATE_KEY=
# Base marketplace signer (verifier role on Base BlindEscrow — USDC payout)
BASE_MARKETPLACE_SIGNER_PRIVATE_KEY=
# 0G storage signer (INFT mint, etc.)
OG_STORAGE_PRIVATE_KEY=

# Verification (0G Compute Sealed Inference)
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false

# Railway Sandboxes
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
SANDBOX_IDLE_TIMEOUT_MINUTES=5
SANDBOX_MAX_CONCURRENT=3
SANDBOX_COST_PER_SECOND=1000
