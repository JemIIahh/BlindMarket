# Server
PORT=3001
# NODE_ENV is the single switch: production = full mainnet (it sets
# SETTLEMENT_TIER=mainnet and DEPLOYMENT_ID=production when they are unset),
# development = testnet defaults. See deriveFromNodeEnv in src/config.ts.
NODE_ENV=production
FRONTEND_URL=https://www.blindmarket.xyz

# Node runtime: prefer IPv4 DNS first on hosts without working IPv6 egress
# (DNS returns v6 addresses first; dead v6 kills outbound calls with empty
# "Cannot connect" errors). Omit on healthy hosts.
# NODE_OPTIONS=--dns-result-order=ipv4first

# Redis
# When running the backend outside Docker (local dev), use redis://localhost:6379.
# When running with docker-compose, the compose service name is `redis`, so use:
REDIS_URL=redis://redis:6379

# Which stack this is, for the Redis ownership check
# (services/deploymentIdentity.ts): "production" on production, which
# NODE_ENV=production fills in when this is unset. A staging
# stack or a local backend on another deployment's Redis stops its
# background writes; production never does (it takes its Redis back).
# DEPLOYMENT_CLAIM, for ONE boot, lets a staging stack take a Redis over on
# purpose: set it to the owner it replaces (/health/bridge
# deploymentIdentity.owner) or "unclaimed".
# DEPLOYMENT_ID=production
# DEPLOYMENT_CLAIM=

# Auth
PRIVY_APP_ID=
AGENT_API_KEY=
JWT_SECRET=change-me-to-a-random-64-char-string
FOUNDER_ADDRESSES=
# Gates CLI/SDK device-flow registration (POST /registration/session,
# /registration/confirm/:token). Defaults to false. Does not affect the web
# agent-deploy flow (POST /agents/deploy).
REGISTRATION_ENABLED=false
# Unix timestamp (seconds). Registration-minted JWTs issued before this time
# are rejected. Setting it to "now" invalidates every previously issued
# registration token and forces re-registration. Leave unset/0 to disable.
REGISTRATION_TOKEN_MIN_IAT=

# CORS
CORS_ORIGIN=http://localhost:5173

# ── 0G Chain (agent infra) ──────────────────────────────────────────────────
OG_RPC_URL=https://0g-rpc.publicnode.com
OG_CHAIN_ID=16661
# Contract addresses (escrow, registry, reputation, INFT, validator pool)
# come from the generated record for OG_CHAIN_ID
# (contracts/deployments/0g-mainnet.json or 0g-testnet.json, via
# contracts/scripts/sync-addresses.ts). There are no address env vars to set.
# Where the 0G indexer's recovery backfill starts. The default, 33459885, is at
# or before the first task on both the 0G mainnet and 0G testnet escrows.
# ESCROW_DEPLOYMENT_BLOCK=33459885

# ── Base Chain (settlement — USDC payouts) ──────────────────────────────────
BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_CHAIN_ID=8453
# The Base escrow, factory and AA addresses likewise come from the generated
# record for BASE_CHAIN_ID (base-mainnet.json / base-sepolia.json). No vars.
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Block the Base escrow was deployed in. Used only when Redis has no Base
# checkpoint (first boot, new Redis): indexing starts there instead of at the
# head, catching up 500 blocks every 5 s. Leave unset to start at the head.
# BASE_ESCROW_DEPLOYMENT_BLOCK=

# ── Arc Chain (settlement — USDC payouts, gas in USDC) ───────────────────────
# Arc is Circle's own L1; USDC is its native gas token (18-dec native view,
# 6-dec ERC-20 at 0x3600…0000 on mainnet and testnet alike). The escrow
# allowlists only the ERC-20.
# ARC_CHAIN_ID picks the network: 5042 (mainnet) or 5042002 (testnet). It
# defaults from the tier: NODE_ENV=production derives SETTLEMENT_TIER=mainnet,
# so production runs Arc mainnet; a stack with no tier (development) falls
# back to testnet. A chain id that contradicts the tier is refused at boot.
# The escrow, factory and deploy blocks default to the generated record for
# that network (contracts/deployments/arc-testnet.json or arc-mainnet.json,
# via sync-addresses.ts): set ARC_CHAIN_ID and leave the rest unset. Set an
# address or block below only to override the record (a redeploy not yet
# recorded). The backend refuses to boot when an RPC serves a chain other
# than the one configured for it.
# An Arc mainnet endpoint you control or pay for. Left unset, the public
# https://rpc.mainnet.arc.io is used, and production warns about it.
ARC_RPC_URL=
ARC_CHAIN_ID=5042
# The Arc escrow and factory likewise come from the generated record for
# ARC_CHAIN_ID (arc-mainnet.json / arc-testnet.json). No vars.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Block the Arc escrow was deployed in (same semantics as the Base one).
# ARC_ESCROW_DEPLOYMENT_BLOCK=
# The agent deploy fee paid on Arc, in USDC's 6-decimal units, as a transfer to
# the Arc escrow's treasury (GET /api/v1/agents/deploy-fee). AGENT_FACTORY_PAYWALL
# (default true) turns the fee on.
# DEPLOY_FEE_USDC_RAW=1000000
# (The Arc factory address and its index start block also come from the
# generated record for ARC_CHAIN_ID. See ARC_ESCROW_DEPLOYMENT_BLOCK above
# for the escrow's equivalent.)

# ── Sponsored agent gas on Arc (docs/AGENT-GAS-FUNDING.md) ──────────────────
# BlindMarket's relayer sends an eligible hosted agent's first submitEvidence
# of a task (and a releaseUnjudgedWork) through its EIP-7702 delegate and pays
# the gas. Off by default. Runs only on Postgres, with DEPLOYMENT_ID set and a
# BlindAgentDelegate recorded for ARC_CHAIN_ID (generated record key
# blindAgentDelegate; ARC_AGENT_DELEGATE_ADDRESS overrides it on staging only).
# Pause or stop it without a restart: POST /api/v1/admin/gas-sponsor/controls
# (FOUNDER_ADDRESSES).
GAS_SPONSOR_ENABLED=false
# The relayer's own key, generated for this and nothing else: sponsorship stays
# off when it matches a key the backend signs with, or the escrow's verifier,
# treasury or admin. Hold no more than two days of budget in it.
GAS_SPONSOR_PRIVATE_KEY=
# Limits (defaults shown). Per-agent, per-user and per-poster caps count
# sponsored tasks in any 24 hours; budgets are in USDC.
# GAS_SPONSOR_MAX_GAS=185000
# GAS_SPONSOR_MAX_FEE_GWEI=100
# GAS_SPONSOR_MIN_TASK_USDC=0.10
# GAS_SPONSOR_PER_AGENT_DAILY=10
# GAS_SPONSOR_PER_USER_DAILY=20
# GAS_SPONSOR_PER_POSTER_DAILY=10
# GAS_SPONSOR_HOURLY_BUDGET_USDC=0.25
# GAS_SPONSOR_DAILY_BUDGET_USDC=1
# GAS_SPONSOR_MAX_STRIKES=3
# GAS_SPONSOR_MAX_FAILURES_PER_HOUR=5
# GAS_SPONSOR_STUCK_MINUTES=10

# ── ERC-4337 Account Abstraction (Base) ─────────────────────────────────────
# Smart accounts let workers pay gas in USDC via the paymaster instead of ETH.
# Addresses come from the generated record for BASE_CHAIN_ID
# (contracts/scripts/sync-addresses.ts). No vars.

# Pimlico bundler for UserOp submission on Base (or any v0.7 ERC-4337 bundler)
PIMLICO_BUNDLER_URL=
PIMLICO_API_KEY=

# ── Circle CCTP V2 (Base <-> another EVM chain USDC bridging) ───────────────
# Default OFF — routes 400 CCTP_DISABLED and the attestation poller no-ops
# until set. Every transfer mints into (or burns from) the user's Arc wallet,
# so the network tier follows ARC_CHAIN_ID, not BASE_CHAIN_ID: 5042 (Arc
# mainnet, production's default) → mainnet chains, mainnet contracts, the live
# Iris API; 5042002 (Arc testnet) → testnet chains, testnet contracts, Iris
# sandbox. Live-verified on testnet (Sep 2026): Eth Sepolia→Base Sepolia and
# Base Sepolia→Arc, Forwarding Service mints.
CCTP_ENABLED=false
# TokenMessengerV2 / MessageTransmitterV2 — same address on every EVM chain
# for a given network tier (Circle's deterministic deployment); defaults
# below are correct for both mainnet and testnet, only override if Circle
# redeploys.
CCTP_TOKEN_MESSENGER_ADDRESS=
CCTP_MESSAGE_TRANSMITTER_ADDRESS=
# Iris attestation API base URL — defaults to the sandbox on Arc testnet, the
# live API on Arc mainnet (the tier follows ARC_CHAIN_ID).
CCTP_IRIS_API_BASE=
# Base leg. Defaults to the settlement Base network (BASE_RPC_URL and
# BASE_USDC_ADDRESS) when that is on the CCTP tier; otherwise to Base on the
# CCTP tier. Only a stack with no tier named (development) can put Base and
# Arc on different tiers: production refuses a chain id off its tier.
CCTP_BASE_RPC_URL=
CCTP_BASE_USDC_ADDRESS=
# Ethereum, Arbitrum, and Optimism — the non-Base CCTP chains wired up today
# (all Fast-Transfer-eligible, so they share the same code path as Base with
# no extra infrastructure). Polygon PoS and Avalanche are deliberately NOT
# included — Circle doesn't support Fast Transfer/Forwarding Service on
# either, which would need a real automated relayer, not just a config
# entry. Default RPCs below are public, rate-limited endpoints (fine for
# testnet) — set real providers (Alchemy/Infura/etc.) before production traffic.
CCTP_ETHEREUM_RPC_URL=
CCTP_ETHEREUM_CHAIN_ID=
CCTP_ETHEREUM_USDC_ADDRESS=
CCTP_ARBITRUM_RPC_URL=
CCTP_ARBITRUM_CHAIN_ID=
CCTP_ARBITRUM_USDC_ADDRESS=
CCTP_OPTIMISM_RPC_URL=
CCTP_OPTIMISM_CHAIN_ID=
CCTP_OPTIMISM_USDC_ADDRESS=
# Arc (Circle's L1), the leg every transfer mints into or burns from. It must
# be the Arc network tasks settle on, so these default to ARC_RPC_URL,
# ARC_CHAIN_ID and ARC_USDC_ADDRESS; leave them unset. With CCTP on, the
# backend refuses to boot when CCTP_ARC_CHAIN_ID disagrees with ARC_CHAIN_ID.
# USDC is Arc's gas token, so a deposit FROM Arc must leave
# CCTP_ARC_GAS_RESERVE_RAW (6-dec USDC; default 50000 = 0.05 USDC) behind to
# pay the approve + burn gas.
CCTP_ARC_RPC_URL=
CCTP_ARC_CHAIN_ID=
CCTP_ARC_USDC_ADDRESS=
CCTP_ARC_GAS_RESERVE_RAW=
# Only needed to run scripts/recover-stuck-cctp-transfer.ts — a wallet with
# native gas on whichever destination chain a stalled transfer is minting
# into (on Arc, native gas is USDC, not ETH). Not used by the running server.
CCTP_RECOVERY_PRIVATE_KEY=

# ── Signers ─────────────────────────────────────────────────────────────────
# 0G marketplace signer (verifier role on 0G BlindEscrow — assignment)
MARKETPLACE_SIGNER_PRIVATE_KEY=
# Base marketplace signer (verifier role on Base BlindEscrow — USDC payout)
BASE_MARKETPLACE_SIGNER_PRIVATE_KEY=
# Arc marketplace signer (verifier role on Arc BlindEscrow — USDC payout)
ARC_MARKETPLACE_SIGNER_PRIVATE_KEY=
# contracts/ deployment set this stack's contracts are recorded in: unset (or
# "default") for production, "staging" for the staging stack. With a set,
# printed rotate-verifier commands select it, and boot fails unless
# OG_CHAIN_ID=16602, BASE_CHAIN_ID=84532, OG_RPC_URL and every contract address
# (including VALIDATOR_POOL_ADDRESS) are set explicitly. See contracts/README.md.
# DEPLOYMENT_SET=
# 0G storage signer (INFT mint, etc.)
OG_STORAGE_PRIVATE_KEY=

# Verification (0G Compute Sealed Inference)
OG_COMPUTE_PRIVATE_KEY=
ALLOW_INSECURE_LOCAL_VERIFY=false

# Railway Sandboxes
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=
SANDBOX_IDLE_TIMEOUT_MINUTES=5
SANDBOX_MAX_CONCURRENT=3
SANDBOX_COST_PER_SECOND=1000

# Per-principal rate limits on the two routes that spend real money per call
# (plan 014). /sandbox/exec runs an arbitrary shell command for up to 600s
# billed to the platform; /verification/verify spends a paid 0G Compute
# inference per call.
SANDBOX_RATE_PER_MIN=10
VERIFY_RATE_PER_MIN=20
# Rolling daily cost ceiling per principal for /sandbox/exec, in micro-units
# (same unit as SANDBOX_COST_PER_SECOND). Enforced via Redis so it survives
# restarts and is shared across instances. Runaway brake, not a billing plan —
# fails OPEN (allows the call) if Redis is unreachable.
SANDBOX_DAILY_COST_CAP_MICRO=10000000

# Sentry DSN for backend error monitoring (5xx + crashes only). Unset = disabled.
SENTRY_DSN=
# Sentry environment tag. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
