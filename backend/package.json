    "@ai-sdk/openai": "^3.0.53",
    "@mastra/core": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mysten/sui": "^2.19.0",
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "^3.1.0",
    "ai": "^6.0.168",
