{
  "name": "blindmarket-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "npx tsx src/index.ts",
    "build": "echo 'No build step needed — using tsx'",
    "typecheck": "tsc --noEmit",
    "typecheck:agents": "tsc -p tsconfig.agents.json",
