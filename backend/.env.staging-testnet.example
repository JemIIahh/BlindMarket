# Backend for the all-testnet STAGING stack: 0G testnet (16602) + Base Sepolia
# (84532), with Arc testnet to follow. It runs like production (NODE_ENV=production)
# but on its own testnet contracts, its own Redis and its own database, and it
# must never touch production's. Copy to the staging host's env; every value
# below is required unless marked optional.
#
# Boot refuses this stack if a DEPLOYMENT_SET=staging variable is missing
# (config.ts DEPLOYMENT_SET_REQUIRED_ENV): an unset address or URL falls back
# to production's. A contract this stack does not deploy is the zero address.

PORT=3001
NODE_ENV=production

# ── Which stack this is ─────────────────────────────────────────────────────
# Names this deployment for the Redis ownership check
# (services/deploymentIdentity.ts). A staging stack claims only a Redis with
# no other deployment's data; on anyone else's it keeps serving HTTP but runs
# no background writes (indexers, sweeps, CCTP poller, agent reconcile and
# agent starts). /health/bridge reports it as deploymentIdentity. To take a
# Redis back on purpose (its record was lost, or this stack's chains moved),
# restart ONCE with DEPLOYMENT_CLAIM set to the owner it replaces (the
# deploymentIdentity.owner /health/bridge shows) or "unclaimed", then remove
# it. It never takes a Redis owned by anyone else.
DEPLOYMENT_ID=staging-testnet
# Contract address records: contracts/deployments/staging/<network>.json.
DEPLOYMENT_SET=staging
# One tier for every settlement chain; a chain id from the other tier is fatal.
SETTLEMENT_TIER=testnet
# NODE_ENV=production on a non-mainnet 0G chain is refused without this.
ALLOW_NONMAINNET_PROD=true
# Where new tasks are escrowed. Base (USDC) matches production; switch to arc
# only once Phase 2 adds it.
POSTING_CHAIN=base

# ── Its own infrastructure — NEVER production's ─────────────────────────────
# A shared Redis is how a testnet backend once poached a mainnet task: the
# A2A queue and indexes are not namespaced by chain.
REDIS_URL=
DATABASE_URL=

# Where this stack lives. Unset, they fall back to production's URLs, which
# boot refuses for DEPLOYMENT_SET=staging.
PUBLIC_API_URL=
PUBLIC_APP_URL=
FRONTEND_URL=
# The staging web app's origin(s), comma-separated.
CORS_ORIGIN=

# ── Auth ────────────────────────────────────────────────────────────────────
# A separate Privy app keeps staging logins and wallets out of production's.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
AGENT_API_KEY=
JWT_SECRET=
FOUNDER_ADDRESSES=

# ── 0G testnet (16602) ──────────────────────────────────────────────────────
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
# From contracts/deployments/staging/0g-testnet.json (deploy with
# DEPLOYMENT_SET=staging). Fresh contracts: never production's.
BLIND_ESCROW_ADDRESS=
TASK_REGISTRY_ADDRESS=
BLIND_REPUTATION_ADDRESS=
INFT_ADDRESS=
# deploy-testnet deploys one; take it from the same record.
VALIDATOR_POOL_ADDRESS=
# The block the staging 0G escrow was deployed in. The 0G indexer starts a
# new Redis at the head; this bounds its on-demand backfill (a task it missed
# is looked for from here). Empty would scan from block 0.
ESCROW_DEPLOYMENT_BLOCK=

# ── Base Sepolia (84532) ────────────────────────────────────────────────────
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# From contracts/deployments/staging/base-sepolia.json. NOT production's
# 0xCca5ab873158b888158AD9Dc36fb4Ee683eFbEBf: rotating its verifier to this
# stack's signer would break production.
BASE_ESCROW_ADDRESS=
# Where the Base indexer starts on a new Redis: the staging escrow's deploy block.
BASE_ESCROW_DEPLOYMENT_BLOCK=
AGENT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# No AgentFactory on staging, so no deploy credit can be bought: without this,
# every hosted-agent deploy answers 402 NO_DEPLOY_CREDIT.
AGENT_FACTORY_PAYWALL=false
BLIND_ACCOUNT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
USDC_PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
ENTRY_POINT_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: a bundler for smart-account agents. Without one they submit from
# their EOA (and the backend assigns the EOA).
PIMLICO_BUNDLER_URL=
PIMLICO_API_KEY=

# ── Marketplace signers: NEW keys for this stack ────────────────────────────
# Each must be its escrow's verifier (contracts: rotate-verifier with
# DEPLOYMENT_SET=staging and EXPECTED_ESCROW). Never production's keys.
MARKETPLACE_SIGNER_PRIVATE_KEY=
BASE_MARKETPLACE_SIGNER_PRIVATE_KEY=

# 0G Storage and 0G Compute (testnet-funded wallets).
OG_STORAGE_PRIVATE_KEY=
OG_COMPUTE_PRIVATE_KEY=

# ── Off on staging ──────────────────────────────────────────────────────────
CCTP_ENABLED=false

# ── Arc testnet (5042002): Phase 2, not settled on yet ──────────────────────
# Nothing to set here yet. The staging Arc escrow is deployed from contracts/
# (deploy-settlement --network arc-testnet with DEPLOYMENT_SET=staging; the
# RPC is contracts/.env ARC_TESTNET_RPC_URL) into
# contracts/deployments/staging/arc-testnet.json, and the backend reads it
# only once Phase 2 adds the 'arc' chain key.

# Optional: error reporting for this stack.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
