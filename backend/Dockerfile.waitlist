# Standalone waitlist service (src/waitlist) — separate from the marketplace
# image; it only ever starts src/waitlist/server.ts. Build from backend/:
#   docker build -f Dockerfile.waitlist -t blindmarket-waitlist .

# Some backend dependencies build native addons during install; the compilers
# stay in this stage and never ship.
FROM node:22-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
USER node
EXPOSE 3100
CMD ["node", "--import", "tsx", "src/waitlist/server.ts"]
