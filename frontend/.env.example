# Network tier: mainnet | testnet. Defaults to testnet.
# This sets both 0G and Base chain IDs + RPC URLs automatically.
VITE_NETWORK=testnet

VITE_API_URL=http://localhost:3001

# Sentry browser DSN (errors only). Unset = Sentry is never initialised.
VITE_SENTRY_DSN=

# Privy is the sole identity provider — required.
# Get an app ID from https://dashboard.privy.io.
VITE_PRIVY_APP_ID=

# 0G Chain (only set these if you want to override the defaults)
# VITE_OG_CHAIN_ID=16602
# VITE_OG_RPC_URL=https://evmrpc-testnet.0g.ai

# Deployed contract addresses (fill these in after deployment)
VITE_BLIND_ESCROW_ADDRESS=
VITE_TASK_REGISTRY_ADDRESS=
VITE_BLIND_REPUTATION_ADDRESS=

# Base Chain (only set these if you want to override the defaults)
# VITE_BASE_CHAIN_ID=84532
# VITE_BASE_RPC_URL=https://sepolia.base.org

# Base contract addresses (fill these in after deployment)
VITE_BASE_ESCROW_ADDRESS=
VITE_BASE_USDC_ADDRESS=
