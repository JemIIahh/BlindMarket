# Web app build for the all-testnet STAGING stack (0G testnet 16602 + Base
# Sepolia 84532). Pairs with backend/.env.staging-testnet.example. Every value
# must point at staging: the app ignores a backend chain whose id differs from
# this build's (config/settlement.ts), so a mismatch shows up as the build's
# own defaults, not as an error.

VITE_NETWORK=testnet
VITE_OG_CHAIN_ID=16602
VITE_BASE_CHAIN_ID=84532

# The staging backend's PUBLIC_API_URL.
VITE_API_URL=

# The staging Privy app (the backend's PRIVY_APP_ID) and its relay signer.
# Left blank, the signer falls back to production's id (config/constants.ts).
VITE_PRIVY_APP_ID=
VITE_PRIVY_RELAY_SIGNER_ID=

# From contracts/deployments/staging/0g-testnet.json and base-sepolia.json:
# the same addresses the staging backend is configured with, never production's.
VITE_BLIND_ESCROW_ADDRESS=
VITE_TASK_REGISTRY_ADDRESS=
VITE_BLIND_REPUTATION_ADDRESS=
VITE_BASE_ESCROW_ADDRESS=
VITE_BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Staging's own Arc escrow (contracts/deployments/staging/arc-testnet.json once
# deployed). Left blank, the build falls back to production's Arc escrow
# (contracts/deployments/arc-testnet.json) whenever the staging backend doesn't
# answer /health/settlement.
VITE_ARC_ESCROW_ADDRESS=

# Optional: a separate Sentry project/DSN for staging.
VITE_SENTRY_DSN=
